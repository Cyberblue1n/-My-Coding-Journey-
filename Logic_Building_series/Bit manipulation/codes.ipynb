   "source": [
    "def findduplicate(arr):\n",
    "    ans = 0\n",
    "    for i in range(1, len(arr)):\n",
    "        ans = ans^i\n",
    "    \n",
    "    for j in range(len(arr)):\n",
    "        ans = ans ^ arr[j]\n",
    "    \n",
    "    return ans\n",
    "\n",
    "arr = [1,3,2,3,4]\n",
    "print(findduplicate(arr))"
   ]
  }
